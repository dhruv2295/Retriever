import app.retriever.core.FileState;

CREATE TABLE files (
  id INTEGER PRIMARY KEY,
  uri TEXT NOT NULL UNIQUE,
  name TEXT NOT NULL,
  folder TEXT NOT NULL,
  mime TEXT NOT NULL,
  kind TEXT NOT NULL,
  size INTEGER NOT NULL,
  modified_at INTEGER NOT NULL,
  state TEXT AS FileState NOT NULL DEFAULT 'PENDING',
  attempts INTEGER NOT NULL DEFAULT 0,
  -- 1: the extractor stopped at a cap (pages, bytes, minutes), so only the first part of the file is searchable.
  partial INTEGER NOT NULL DEFAULT 0,
  -- When the photo or video was taken, in ms like modified_at; null when the source doesn't say.
  taken_at INTEGER,
  -- What the file's chunks hold, as Store.Reach bits; refreshReach keeps it after every chunk write, so the counts
  -- group files instead of looking inside chunks. Added in 6.sqm.
  reach INTEGER NOT NULL DEFAULT 0,
  -- The duplicate finder's hashes of the file's content; upsertFile clears them when the file changes. Added in 7.sqm.
  quick_hash TEXT,
  full_hash TEXT
);

CREATE INDEX files_by_folder ON files(folder);

CREATE INDEX files_by_state ON files(state);

-- Covers reachCounts, so the counts of a whole library are one index scan; (kind, state) lookups use its prefix.
CREATE INDEX files_by_reach ON files(kind, state, partial, reach);

-- The Home lists (filesNewest, filesLargest) read these in order instead of sorting every file, filesCaptured searches
-- by kind and capture time, and relinkStars searches by size. Added in 3.sqm.
CREATE INDEX files_by_modified ON files(modified_at DESC, id);

CREATE INDEX files_by_size ON files(size DESC, id);

CREATE INDEX files_by_kind_time ON files(kind, COALESCE(taken_at, modified_at) DESC);

-- AUTOINCREMENT keeps ids monotonic, so SearchEngine can load only rows above the last id it saw.
CREATE TABLE chunks (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
  ordinal INTEGER NOT NULL,
  locator TEXT NOT NULL DEFAULT '',
  text TEXT,
  -- NULL: a text tail chunk, keyword-searchable now, embedded by the deepen pass.
  vector BLOB,
  scale REAL,
  -- Deepen-pass tries, counted before each embed so a chunk that kills the process is given up on.
  tail_attempts INTEGER NOT NULL DEFAULT 0,
  content_text TEXT,
  labels TEXT,
  visual INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX chunks_by_file ON chunks(file_id);

CREATE INDEX chunks_tail ON chunks(file_id, tail_attempts) WHERE vector IS NULL;

-- tokenchars: every combining mark (Unicode Mn and Mc) outside the generic diacritic blocks that remove_diacritics
-- folds. unicode61 would otherwise split words at the vowel signs of Indic and Southeast Asian scripts
-- ('बिजली' would index as ब | जल | ...). Generated, never hand-edited: SchemaV3Test checks it and rewrites it on
-- request. Same tokenizer on both tables, and in 2.sqm.
CREATE VIRTUAL TABLE chunk_fts USING fts4(text, labels, tokenize=unicode61 "remove_diacritics=2" "tokenchars=ְֱֲֳִֵֶַָׇֹֺֻּֽֿׁׂًٌٍؘَؙُؚِّْٰܑ֑֖֛֢֣֤֥֦֧֪ׅٕٖٜٟۣ۪ۭܱܴܷܸܹܻܼܾ݂݄݆݈֚֭֮҃҄҅҆҇֒֓֔֕֗֘֙֜֝֞֟֠֡֨֩֫֬֯ׄؐؑؒؓؔؕؖؗٓٔٗ٘ٙٚٛٝٞۖۗۘۙۚۛۜ۟۠ۡۢۤۧۨ۫۬ܰܲܳܵܶܺܽܿ݀݁݃݅݇݉݊ަާިީުޫެޭޮޯްࣰࣱࣲ߲߽࡙࡚࡛࢙࢚࢛࣏࣐࣑࣒࣓ࣣࣦࣩ࣭࣮࣯ࣶࣹࣺ߫߬߭߮߯߰߱߳ࠖࠗ࠘࠙ࠛࠜࠝࠞࠟࠠࠡࠢࠣࠥࠦࠧࠩࠪࠫࠬ࠭ࢗ࢘࢜࢝࢞࢟࣊࣋࣌࣍࣎ࣔࣕࣖࣗࣘࣙࣚࣛࣜࣝࣞࣟ࣠࣡ࣤࣥࣧࣨ࣪࣫࣬ࣳࣴࣵࣷࣸࣻࣼࣽࣾࣿऀँंःऺऻ़ािीुूृॄॅॆेैॉॊोौ्ॎॏ॒॑॓॔ॕॖॗॢॣঁংঃ়ািীুূৃৄেৈোৌ্ৗৢৣ৾ਁਂਃ਼ਾਿੀੁੂੇੈੋੌ੍ੑੰੱੵઁંઃ઼ાિીુૂૃૄૅેૈૉોૌ્ૢૣૺૻૼ૽૾૿ଁଂଃ଼ାିୀୁୂୃୄେୈୋୌ୍୕ୖୗୢୣஂாிீுூெேைொோௌ்ௗఀఁంఃఄ఼ాిీుూృౄెేైొోౌ్ౕౖౢౣಁಂಃ಼ಾಿೀುೂೃೄೆೇೈೊೋೌ್ೕೖೢೣೳഀഁംഃ഻഼ാിീുൂൃൄെേൈൊോൌ്ൗൢൣඁංඃ්ාැෑිීුූෘෙේෛොෝෞෟෲෳัิีึืฺุู็่้๊๋์ํ๎ັິີຶື຺ຸູົຼ່້໊໋໌ໍ໎༹༘༙༵༷༾༿ཱཱཱིིུུྲྀཷླྀཹེཻོཽཾཿ྄ཱྀྀྂྃ྆྇ྍྎྏྐྑྒྒྷྔྕྖྗྙྚྛྜྜྷྞྟྠྡྡྷྣྤྥྦྦྷྨྩྪྫྫྷྭྮྯྰྱྲླྴྵྶྷྸྐྵྺྻྼ࿆ါာိီုူေဲဳဴဵံ့း္်ျြွှၖၗၘၙၞၟၠၢၣၤၧၨၩၪၫၬၭၱၲၳၴႂႃႄႅႆႇႈႉႊႋႌႍႏႚႛႜႝ፝፞፟ᜒᜓ᜔᜕ᜲᜳ᜴ᝒᝓᝲᝳ឴឵ាិីឹឺុូួើឿៀេែៃោៅំះៈ៉៊់៌៍៎៏័៑្៓៝᠋᠌᠍᠏ᢅᢆᢩᤠᤡᤢᤣᤤᤥᤦᤧᤨᤩᤪᤫᤰᤱᤲᤳᤴᤵᤶᤷᤸ᤻ᨘ᤹᤺ᨗᨙᨚᨛᩕᩖᩗᩘᩙᩚᩛᩜᩝᩞ᩠ᩡᩢᩣᩤᩥᩦᩧᩨᩩᩪᩫᩬᩭᩮᩯᩰᩱᩲᩳᩴ᩿᩵᩶᩷᩸᩹᩺᩻᩼ᬀᬁᬂᬃᬄ᬴ᬵᬶᬷᬸᬹᬺᬻᬼᬽᬾᬿᭀᭁᭂᭃ᭄᭬᭫᭭᭮᭯᭰᭱᭲᭳ᮀᮁᮂᮡᮢᮣᮤᮥᮦᮧᮨᮩ᮪᮫ᮬᮭ᯦ᯧᯨᯩᯪᯫᯬᯭᯮᯯᯰᯱ᯲᯳ᰤᰥᰦᰧᰨᰩᰪᰫᰬᰭᰮᰯᰰᰱᰲᰳᰴᰵᰶ᳔᰷᳕᳖᳗᳘᳙᳜᳝᳞᳟᳐᳑᳒᳚᳛᳠᳡᳢᳣᳤᳥᳦᳧᳨᳭᳴᳷゙゚⵿〪〭〮〯〫᳸᳹⳯⳰⳱ⷠⷡⷢⷣⷤⷥⷦⷧⷨⷩⷪⷫⷬⷭⷮⷯⷰⷱⷲⷳⷴⷵⷶⷷⷸⷹⷺⷻⷼⷽⷾⷿ꙯ꙴꙵꙶꙷꙸꙹꙺꙻ꙼꙽ꚞꚟ꛰꛱〬ꠂ꠆ꠋꠣꠤꠥꠦꠧ꠬ꢀꢁꢴꢵꢶꢷꢸꢹꢺꢻꢼꢽꢾꢿꣀꣁꣂꣃ꣄ꣅ꣠꣡꣢꣣꣤꣥꣦꣧꣨꣩꣪꣫꣬꣭꣮꣯꣰꣱ꣿꤦꤧꤨꤩꤪ꤫꤬꤭ꥇꥈꥉꥊꥋꥌꥍꥎꥏꥐꥑꥒ꥓ꦀꦁꦂꦃ꦳ꦴꦵꦶꦷꦸꦹꦺꦻꦼꦽꦾꦿ꧀ꧥꨩꨪꨫꨬꨭꨮꨯꨰꨱꨲꨳꨴꨵꨶꩃꩌꩍꩻꩼꩽꪴꪰꪲꪳꪷꪸꪾ꪿꫁ꫫꫬꫭꫮꫯꫵ꫶ꯣꯤꯥꯦꯧꯨꯩꯪ꯬꯭ﬞ︀︁︂︃︄︅︆︇︈︉︊︋︌︍︎️");

-- rowid = files.id. Names reach keyword search here as soon as a file is synced, before any embedding.
CREATE VIRTUAL TABLE file_fts USING fts4(name, folder, tokenize=unicode61 "remove_diacritics=2" "tokenchars=ְֱֲֳִֵֶַָׇֹֺֻּֽֿׁׂًٌٍؘَؙُؚِّْٰܑ֑֖֛֢֣֤֥֦֧֪ׅٕٖٜٟۣ۪ۭܱܴܷܸܹܻܼܾ݂݄݆݈֚֭֮҃҄҅҆҇֒֓֔֕֗֘֙֜֝֞֟֠֡֨֩֫֬֯ׄؐؑؒؓؔؕؖؗٓٔٗ٘ٙٚٛٝٞۖۗۘۙۚۛۜ۟۠ۡۢۤۧۨ۫۬ܰܲܳܵܶܺܽܿ݀݁݃݅݇݉݊ަާިީުޫެޭޮޯްࣰࣱࣲ߲߽࡙࡚࡛࢙࢚࢛࣏࣐࣑࣒࣓ࣣࣦࣩ࣭࣮࣯ࣶࣹࣺ߫߬߭߮߯߰߱߳ࠖࠗ࠘࠙ࠛࠜࠝࠞࠟࠠࠡࠢࠣࠥࠦࠧࠩࠪࠫࠬ࠭ࢗ࢘࢜࢝࢞࢟࣊࣋࣌࣍࣎ࣔࣕࣖࣗࣘࣙࣚࣛࣜࣝࣞࣟ࣠࣡ࣤࣥࣧࣨ࣪࣫࣬ࣳࣴࣵࣷࣸࣻࣼࣽࣾࣿऀँंःऺऻ़ािीुूृॄॅॆेैॉॊोौ्ॎॏ॒॑॓॔ॕॖॗॢॣঁংঃ়ািীুূৃৄেৈোৌ্ৗৢৣ৾ਁਂਃ਼ਾਿੀੁੂੇੈੋੌ੍ੑੰੱੵઁંઃ઼ાિીુૂૃૄૅેૈૉોૌ્ૢૣૺૻૼ૽૾૿ଁଂଃ଼ାିୀୁୂୃୄେୈୋୌ୍୕ୖୗୢୣஂாிீுூெேைொோௌ்ௗఀఁంఃఄ఼ాిీుూృౄెేైొోౌ్ౕౖౢౣಁಂಃ಼ಾಿೀುೂೃೄೆೇೈೊೋೌ್ೕೖೢೣೳഀഁംഃ഻഼ാിീുൂൃൄെേൈൊോൌ്ൗൢൣඁංඃ්ාැෑිීුූෘෙේෛොෝෞෟෲෳัิีึืฺุู็่้๊๋์ํ๎ັິີຶື຺ຸູົຼ່້໊໋໌ໍ໎༹༘༙༵༷༾༿ཱཱཱིིུུྲྀཷླྀཹེཻོཽཾཿ྄ཱྀྀྂྃ྆྇ྍྎྏྐྑྒྒྷྔྕྖྗྙྚྛྜྜྷྞྟྠྡྡྷྣྤྥྦྦྷྨྩྪྫྫྷྭྮྯྰྱྲླྴྵྶྷྸྐྵྺྻྼ࿆ါာိီုူေဲဳဴဵံ့း္်ျြွှၖၗၘၙၞၟၠၢၣၤၧၨၩၪၫၬၭၱၲၳၴႂႃႄႅႆႇႈႉႊႋႌႍႏႚႛႜႝ፝፞፟ᜒᜓ᜔᜕ᜲᜳ᜴ᝒᝓᝲᝳ឴឵ាិីឹឺុូួើឿៀេែៃោៅំះៈ៉៊់៌៍៎៏័៑្៓៝᠋᠌᠍᠏ᢅᢆᢩᤠᤡᤢᤣᤤᤥᤦᤧᤨᤩᤪᤫᤰᤱᤲᤳᤴᤵᤶᤷᤸ᤻ᨘ᤹᤺ᨗᨙᨚᨛᩕᩖᩗᩘᩙᩚᩛᩜᩝᩞ᩠ᩡᩢᩣᩤᩥᩦᩧᩨᩩᩪᩫᩬᩭᩮᩯᩰᩱᩲᩳᩴ᩿᩵᩶᩷᩸᩹᩺᩻᩼ᬀᬁᬂᬃᬄ᬴ᬵᬶᬷᬸᬹᬺᬻᬼᬽᬾᬿᭀᭁᭂᭃ᭄᭬᭫᭭᭮᭯᭰᭱᭲᭳ᮀᮁᮂᮡᮢᮣᮤᮥᮦᮧᮨᮩ᮪᮫ᮬᮭ᯦ᯧᯨᯩᯪᯫᯬᯭᯮᯯᯰᯱ᯲᯳ᰤᰥᰦᰧᰨᰩᰪᰫᰬᰭᰮᰯᰰᰱᰲᰳᰴᰵᰶ᳔᰷᳕᳖᳗᳘᳙᳜᳝᳞᳟᳐᳑᳒᳚᳛᳠᳡᳢᳣᳤᳥᳦᳧᳨᳭᳴᳷゙゚⵿〪〭〮〯〫᳸᳹⳯⳰⳱ⷠⷡⷢⷣⷤⷥⷦⷧⷨⷩⷪⷫⷬⷭⷮⷯⷰⷱⷲⷳⷴⷵⷶⷷⷸⷹⷺⷻⷼⷽⷾⷿ꙯ꙴꙵꙶꙷꙸꙹꙺꙻ꙼꙽ꚞꚟ꛰꛱〬ꠂ꠆ꠋꠣꠤꠥꠦꠧ꠬ꢀꢁꢴꢵꢶꢷꢸꢹꢺꢻꢼꢽꢾꢿꣀꣁꣂꣃ꣄ꣅ꣠꣡꣢꣣꣤꣥꣦꣧꣨꣩꣪꣫꣬꣭꣮꣯꣰꣱ꣿꤦꤧꤨꤩꤪ꤫꤬꤭ꥇꥈꥉꥊꥋꥌꥍꥎꥏꥐꥑꥒ꥓ꦀꦁꦂꦃ꦳ꦴꦵꦶꦷꦸꦹꦺꦻꦼꦽꦾꦿ꧀ꧥꨩꨪꨫꨬꨭꨮꨯꨰꨱꨲꨳꨴꨵꨶꩃꩌꩍꩻꩼꩽꪴꪰꪲꪳꪷꪸꪾ꪿꫁ꫫꫬꫭꫮꫯꫵ꫶ꯣꯤꯥꯦꯧꯨꯩꯪ꯬꯭ﬞ︀︁︂︃︄︅︆︇︈︉︊︋︌︍︎️");

CREATE TABLE index_meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

-- Lets SearchEngine notice deleted vectors with one row read instead of a count over every chunk.
CREATE TRIGGER vector_deleted AFTER DELETE ON chunks WHEN old.vector IS NOT NULL
BEGIN
  INSERT OR REPLACE INTO index_meta (key, value)
  VALUES ('vectors_deleted', CAST(COALESCE((SELECT CAST(value AS INTEGER) FROM index_meta WHERE key = 'vectors_deleted'), 0) + 1 AS TEXT));
END;

CREATE TABLE recent_queries (
  phrase TEXT NOT NULL PRIMARY KEY,
  at INTEGER NOT NULL
);

-- Keyed by URI with no link to files, so a reset, a model change or a file going away for a while never touches
-- stars. name, size and modified_at record which file was starred.
CREATE TABLE starred (
  uri TEXT NOT NULL PRIMARY KEY,
  starred_at INTEGER NOT NULL,
  name TEXT NOT NULL,
  size INTEGER NOT NULL,
  modified_at INTEGER NOT NULL
);

CREATE INDEX starred_by_time ON starred(starred_at DESC);

-- taken_at is not in the guard below: there it would queue every file again. A changed file takes the new one (an
-- edited capture date rewrites the file); setTakenAt fills rows synced before the column existed.
upsertFile:
INSERT INTO files (uri, name, folder, mime, kind, size, modified_at, state, attempts, taken_at)
VALUES (?, ?, ?, ?, ?, ?, ?, 'PENDING', 0, ?)
ON CONFLICT(uri) DO UPDATE SET
  name = excluded.name, folder = excluded.folder, mime = excluded.mime, kind = excluded.kind,
  size = excluded.size, modified_at = excluded.modified_at, taken_at = excluded.taken_at, state = 'PENDING', attempts = 0, partial = 0,
  reach = 0, quick_hash = NULL, full_hash = NULL
WHERE files.modified_at != excluded.modified_at OR files.size != excluded.size OR files.name != excluded.name OR files.folder != excluded.folder
  OR files.kind != excluded.kind OR files.mime != excluded.mime;

setTakenAt:
UPDATE files SET taken_at = ? WHERE uri = ? AND taken_at IS NULL;

changes:
SELECT changes();

fileIdByUri:
SELECT id FROM files WHERE uri = ?;

fileByUri:
SELECT * FROM files WHERE uri = ?;

fileIdsByUris:
SELECT id FROM files WHERE uri IN ?;

-- Only what the name index keeps, so building it never reads whole rows.
nameEntries:
SELECT id, name, folder, kind, COALESCE(taken_at, modified_at) AS at FROM files;

nameEntriesByUris:
SELECT id, name, folder, kind, COALESCE(taken_at, modified_at) AS at FROM files WHERE uri IN ?;

allFiles:
SELECT * FROM files;

allUris:
SELECT uri FROM files;

fileCount:
SELECT COUNT(*) FROM files;

folderCounts:
SELECT folder, COUNT(*) AS n FROM files GROUP BY folder ORDER BY n DESC;

folderCount:
SELECT COUNT(DISTINCT folder) FROM files;

-- More on your phone: per kind and per folder, over the same rows the reading counts use. A size of 0 or less is
-- unknown (iOS Photos reports none), never 0 B. Grouped in files_by_kind_time and files_by_folder order, without a sort.
-- ponytail: each row is looked up for its size; covering (kind, size) and (folder, size) indexes if this shows up.
kindTotals:
SELECT kind, COUNT(*) AS files, CAST(COALESCE(SUM(CASE WHEN size > 0 THEN size END), 0) AS INTEGER) AS knownBytes,
  CAST(COALESCE(SUM(size <= 0), 0) AS INTEGER) AS unknownSizes
FROM files GROUP BY kind;

folderTotals:
SELECT folder, COUNT(*) AS files, CAST(COALESCE(SUM(CASE WHEN size > 0 THEN size END), 0) AS INTEGER) AS knownBytes,
  CAST(COALESCE(SUM(size <= 0), 0) AS INTEGER) AS unknownSizes
FROM files GROUP BY folder ORDER BY files DESC, folder;

-- By capture time, so a restored phone still shows the newest captures first; PDF and DOC have no taken_at.
filesNewestOfKinds:
SELECT * FROM files WHERE kind IN ? ORDER BY COALESCE(taken_at, modified_at) DESC, id LIMIT ?;

filesByUris:
SELECT * FROM files WHERE uri IN ?;

-- Home's On this day. Both taken_at IS NOT NULL and the COALESCE(...) BETWEEN form: taken_at BETWEEN loses
-- files_by_kind_time, which indexes the COALESCE expression.
mediaTakenSince:
SELECT MIN(COALESCE(taken_at, modified_at)) FROM files WHERE kind = 'PHOTO' AND taken_at IS NOT NULL;

mediaTakenBetween:
SELECT COUNT(*) AS n,
       CAST(COALESCE(SUM(kind = 'VIDEO'), 0) AS INTEGER) AS videos,
       COALESCE(MAX(CASE WHEN kind = 'PHOTO' THEN id END), MAX(id)) AS coverId
FROM files
WHERE kind IN ('PHOTO', 'VIDEO') AND taken_at IS NOT NULL
  AND COALESCE(taken_at, modified_at) BETWEEN :from AND :to;

filesTakenBetween:
SELECT * FROM files WHERE kind IN ('PHOTO', 'VIDEO') AND taken_at IS NOT NULL
  AND COALESCE(taken_at, modified_at) BETWEEN :from AND :to
ORDER BY COALESCE(taken_at, modified_at), id LIMIT :limit OFFSET :offset;

-- A query that is all filters: files of the kinds captured in [from, to), newest capture first.
filesCaptured:
SELECT * FROM files
WHERE kind IN :kinds AND COALESCE(taken_at, modified_at) >= :from AND COALESCE(taken_at, modified_at) < :to
  AND (:starredOnly = 0 OR uri IN (SELECT uri FROM starred))
ORDER BY COALESCE(taken_at, modified_at) DESC, id
LIMIT :limit;

largeFiles:
SELECT COUNT(*), COALESCE(SUM(size), 0) FROM files WHERE size >= ?;

-- Read by name only: indexed, but nothing inside became a chunk (reach bit 1, Store.Reach.CONTENT).
nameOnlyCount:
SELECT COUNT(*) FROM files WHERE state = 'INDEXED' AND reach & 1 = 0;

filesByIds:
SELECT * FROM files WHERE id IN ?;

filesNewest:
SELECT * FROM files
WHERE (:kind IS NULL OR kind = :kind) AND (:folder IS NULL OR folder = :folder)
ORDER BY modified_at DESC, id
LIMIT :limit OFFSET :offset;

filesLargest:
SELECT * FROM files
WHERE (:kind IS NULL OR kind = :kind) AND (:folder IS NULL OR folder = :folder)
ORDER BY size DESC, id
LIMIT :limit OFFSET :offset;

filesName:
SELECT * FROM files
WHERE (:kind IS NULL OR kind = :kind) AND (:folder IS NULL OR folder = :folder)
ORDER BY name COLLATE NOCASE ASC, id
LIMIT :limit OFFSET :offset;

setQuickHash:
UPDATE files SET quick_hash = ? WHERE id = ?;

setFullHash:
UPDATE files SET full_hash = ? WHERE id = ?;

sizeCollisions:
SELECT * FROM files
WHERE size IN (SELECT size FROM files WHERE size >= :minSize GROUP BY size HAVING COUNT(*) > 1)
ORDER BY size DESC, modified_at ASC;

-- How many files share a size with another: the finder's first, cheap stage, so Home knows whether copies are possible.
sizeCollisionCount:
SELECT COUNT(*) FROM files
WHERE size IN (SELECT size FROM files WHERE size >= :minSize GROUP BY size HAVING COUNT(*) > 1);

requeue:
UPDATE files SET state = 'PENDING', attempts = 0 WHERE state = 'INDEXED' AND kind IN ?;

-- A kind no longer read inside: its text goes, FTS rows first, and its files stay, found by name. Ordinal 0 is a name
-- vector (no text), which extraction keeps for such a file too.
deleteFtsOfKinds:
DELETE FROM chunk_fts WHERE rowid IN (SELECT c.id FROM chunks c JOIN files f ON f.id = c.file_id WHERE f.kind IN ?);

deleteChunksOfKinds:
DELETE FROM chunks WHERE ordinal > 0 AND file_id IN (SELECT id FROM files WHERE kind IN ?);

clearPartialOfKinds:
UPDATE files SET partial = 0 WHERE kind IN ?;

retrySkipped:
UPDATE files SET state = 'PENDING', attempts = 0 WHERE state = 'SKIPPED';

skippedFiles:
SELECT * FROM files WHERE state = 'SKIPPED' AND kind IN :kinds AND reach & 1 = 0
ORDER BY name COLLATE NOCASE ASC, id LIMIT :limit;

fileById:
SELECT * FROM files WHERE id = ?;

-- Cheap kinds first (screenshots, documents, PDFs), then photos, then videos (seconds of frames each), newest first, audio last.
pendingFiles:
SELECT * FROM files WHERE state = 'PENDING'
ORDER BY CASE kind WHEN 'SCREENSHOT' THEN 0 WHEN 'DOC' THEN 1 WHEN 'PDF' THEN 2 WHEN 'PHOTO' THEN 3 WHEN 'VIDEO' THEN 4 WHEN 'AUDIO' THEN 5 ELSE 6 END, modified_at DESC
LIMIT ?;

-- Sample mode: the pending files among the newest :n of one kind, read or not, so the sample never grows past n.
pendingNewestOfKind:
SELECT * FROM files WHERE state = 'PENDING'
AND id IN (SELECT id FROM files WHERE kind = :kind ORDER BY modified_at DESC, id LIMIT :n)
ORDER BY modified_at DESC;

pendingIn:
SELECT * FROM files WHERE state = 'PENDING' AND id IN ?;

pendingBytesOfKind:
SELECT COALESCE(SUM(size), 0) FROM files WHERE state = 'PENDING' AND kind = ?;

setState:
UPDATE files SET state = ?, attempts = ? WHERE id = ?;

setIndexed:
UPDATE files SET state = 'INDEXED', attempts = ?, partial = ? WHERE id = ?;

partialFiles:
SELECT id FROM files WHERE id IN ? AND partial = 1;

-- Files with a later pass to come: text, or a page or moment left for later, beside vectors already added. A file with no vector yet only waits for meaning,
-- a count and never a Partly read file.
deepeningFiles:
SELECT DISTINCT c.file_id FROM chunks c JOIN files f ON f.id = c.file_id
WHERE c.file_id IN ? AND f.state = 'INDEXED' AND c.ordinal > 0 AND c.vector IS NULL AND c.tail_attempts < 3
  AND (length(trim(c.content_text)) > 0 OR c.visual = 1)
  AND EXISTS (SELECT 1 FROM chunks d WHERE d.file_id = c.file_id AND d.ordinal > 0
    AND (d.vector IS NOT NULL OR (d.tail_attempts >= 3 AND length(trim(d.content_text)) > 0)));

deleteFileById:
DELETE FROM files WHERE id = ?;

countByState:
SELECT state, COUNT(*) FROM files GROUP BY state;

countByKindState:
SELECT kind, state, COUNT(*) FROM files GROUP BY kind, state;

chunkIdsForFile:
SELECT id FROM chunks WHERE file_id = ?;

deleteChunksForFile:
DELETE FROM chunks WHERE file_id = ?;

deleteChunk:
DELETE FROM chunks WHERE id = ?;

insertChunk:
INSERT INTO chunks (file_id, ordinal, locator, text, vector, scale, content_text, labels, visual) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastId:
SELECT last_insert_rowid();

-- hasText and ordinal give the row's modality (Modality.of): an image's words (an OCR scrap) leave it an image. at is the
-- capture time for date filters.
vectorsAfter:
SELECT c.id, c.file_id, c.vector, c.scale, f.kind, (c.text IS NOT NULL AND c.visual = 0) AS hasText, c.ordinal, COALESCE(f.taken_at, f.modified_at) AS at
FROM chunks c JOIN files f ON f.id = c.file_id
WHERE c.vector IS NOT NULL AND c.id > ? ORDER BY c.id LIMIT ?;

vectorCount:
SELECT COUNT(*) FROM chunks WHERE vector IS NOT NULL;

vectorsDeleted:
SELECT value FROM index_meta WHERE key = 'vectors_deleted';

-- Pages and moments left for the deepen pass (Extraction.LATER), for a batch without the model to resolve.
laterChunks:
SELECT c.id, c.file_id, c.ordinal, c.locator, c.text, f.name, c.tail_attempts, c.visual
FROM chunks c JOIN files f ON f.id = c.file_id
WHERE f.state = 'INDEXED' AND c.locator LIKE 'later:%' AND c.tail_attempts < 3
ORDER BY c.id
LIMIT ?;

laterChunkCount:
SELECT COUNT(*) FROM chunks c JOIN files f ON f.id = c.file_id
WHERE f.state = 'INDEXED' AND c.locator LIKE 'later:%' AND c.tail_attempts < 3;

tailChunks:
SELECT c.id, c.file_id, c.ordinal, c.locator, c.text, f.name, c.tail_attempts, c.visual
FROM chunks c JOIN files f ON f.id = c.file_id
WHERE f.state = 'INDEXED' AND c.vector IS NULL AND c.tail_attempts < 3
ORDER BY CASE f.kind WHEN 'SCREENSHOT' THEN 0 WHEN 'DOC' THEN 1 WHEN 'PDF' THEN 2 WHEN 'PHOTO' THEN 3 WHEN 'VIDEO' THEN 4 WHEN 'AUDIO' THEN 5 ELSE 6 END, f.modified_at DESC, c.id
LIMIT ?;

tailChunksIn:
SELECT c.id, c.file_id, c.ordinal, c.locator, c.text, f.name, c.tail_attempts, c.visual
FROM chunks c JOIN files f ON f.id = c.file_id
WHERE f.state = 'INDEXED' AND c.vector IS NULL AND c.tail_attempts < 3 AND c.file_id IN ?
ORDER BY c.id;

tailCountsIn:
SELECT COUNT(*), COUNT(DISTINCT file_id) FROM chunks WHERE file_id IN (SELECT id FROM files WHERE state = 'INDEXED') AND vector IS NULL AND tail_attempts < 3 AND file_id IN ?;

tailChunkCount:
SELECT COUNT(*) FROM chunks WHERE file_id IN (SELECT id FROM files WHERE state = 'INDEXED') AND vector IS NULL AND tail_attempts < 3;

tailFileCount:
SELECT COUNT(DISTINCT file_id) FROM chunks WHERE file_id IN (SELECT id FROM files WHERE state = 'INDEXED') AND vector IS NULL AND tail_attempts < 3;

setTailAttempts:
UPDATE chunks SET tail_attempts = ? WHERE id = ?;

fileIdOfChunk:
SELECT file_id FROM chunks WHERE id = ?;

-- v5 fresh databases put content_text before vector; upgraded ones appended it. Never depend on physical column order.
chunkById:
SELECT id, file_id, ordinal, locator, text, vector, scale, tail_attempts, content_text, labels, visual FROM chunks WHERE id = ?;

chunksByIds:
SELECT id, file_id, locator, text FROM chunks WHERE id IN ?;

chunkTextsOfFile:
SELECT id, ordinal, locator, content_text FROM chunks WHERE file_id = ? AND content_text IS NOT NULL ORDER BY ordinal, id;

-- The first text at each place, for many places at once; SQLite returns the text of the row that holds MIN(ordinal).
firstTextAtMany:
SELECT file_id, locator, content_text, MIN(ordinal) FROM chunks
WHERE file_id IN :fileIds AND locator IN :locators AND content_text IS NOT NULL
GROUP BY file_id, locator;

insertFts:
INSERT INTO chunk_fts (rowid, text, labels) VALUES (?, ?, ?);

deleteFts:
DELETE FROM chunk_fts WHERE rowid = ?;

-- The newest matches, for ranking without snippet(); snippets are cut only for the winners (ftsSnippets).
searchFts:
SELECT CAST(rowid AS INTEGER) AS chunkId, CAST(matchinfo(chunk_fts, 'pcnalx') AS BLOB) AS info
FROM chunk_fts WHERE chunk_fts MATCH ? ORDER BY rowid DESC LIMIT ?;

-- As searchFts, among files of the given kinds captured between from and to, filtered before the LIMIT. The id set
-- comes from chunks_by_file, which covers (file_id, id), so the filter never reads the wide chunk rows; '+' keeps
-- SQLite from turning it into docid lookups.
searchFtsOfKinds:
SELECT CAST(rowid AS INTEGER) AS chunkId, CAST(matchinfo(chunk_fts, 'pcnalx') AS BLOB) AS info
FROM chunk_fts
WHERE chunk_fts MATCH :match AND +rowid IN (SELECT id FROM chunks WHERE file_id IN (
  SELECT id FROM files WHERE kind IN :kinds AND COALESCE(taken_at, modified_at) BETWEEN :from AND :to
    AND (:starredOnly = 0 OR uri IN (SELECT uri FROM starred))
))
ORDER BY rowid DESC LIMIT :limit;

ftsSnippets:
SELECT CAST(rowid AS INTEGER) AS chunkId, snippet(chunk_fts, char(2), char(3), '…', 0, 12) AS snippet
FROM chunk_fts WHERE chunk_fts MATCH ? AND rowid IN ?
AND rowid IN (SELECT id FROM chunks WHERE content_text IS NOT NULL);

insertFileFts:
INSERT INTO file_fts (rowid, name, folder) VALUES (?, ?, ?);

deleteFileFts:
DELETE FROM file_fts WHERE rowid = ?;

searchFileFts:
SELECT CAST(file_fts.rowid AS INTEGER) AS fileId, CAST(matchinfo(file_fts, 'pcnalx') AS BLOB) AS info, f.kind,
  COALESCE(f.taken_at, f.modified_at) AS at
FROM file_fts JOIN files f ON f.id = file_fts.rowid
WHERE file_fts MATCH :match AND f.kind IN :kinds AND COALESCE(f.taken_at, f.modified_at) BETWEEN :from AND :to
ORDER BY file_fts.rowid DESC LIMIT :cap;

chunkCount:
SELECT COUNT(*) FROM chunks;

getMeta:
SELECT value FROM index_meta WHERE key = ?;

setMeta:
INSERT OR REPLACE INTO index_meta (key, value) VALUES (?, ?);

deleteMeta:
DELETE FROM index_meta WHERE key = ?;

bumpMeta:
INSERT OR REPLACE INTO index_meta (key, value)
VALUES (:key, CAST(COALESCE((SELECT CAST(value AS INTEGER) FROM index_meta WHERE key = :key), 0) + 1 AS TEXT));

-- After 2.sqm recreated the keyword tables empty. Rows the indexer wrote since then are skipped, not doubled.
rebuildFts {
  INSERT INTO chunk_fts (rowid, text, labels) SELECT id, text, labels FROM chunks
    WHERE (text IS NOT NULL OR labels IS NOT NULL) AND id NOT IN (SELECT rowid FROM chunk_fts);
  INSERT INTO file_fts (rowid, name, folder) SELECT id, name, folder FROM files
    WHERE id NOT IN (SELECT rowid FROM file_fts);
  DELETE FROM index_meta WHERE key = 'fts_rebuild';
}

resetForNewModel {
  INSERT OR REPLACE INTO index_meta (key, value)
    SELECT 'vectors_deleted', CAST(COALESCE((SELECT CAST(value AS INTEGER) FROM index_meta WHERE key = 'vectors_deleted'), 0) + COUNT(vector) AS TEXT) FROM chunks;
  UPDATE chunks SET vector = NULL, scale = NULL, tail_attempts = 0;
  -- Videos read before the model have no frames (IndexEngine reads none without it): read them again, frames and all.
  UPDATE files SET state = 'PENDING', attempts = 0 WHERE kind = 'VIDEO' AND state = 'INDEXED'
    AND id NOT IN (SELECT file_id FROM chunks WHERE ordinal > 0);
  INSERT INTO chunks (file_id, ordinal, locator)
    SELECT id, 0, '' FROM files WHERE state = 'INDEXED' AND id NOT IN (SELECT file_id FROM chunks);
}

addRecentQuery {
  INSERT OR REPLACE INTO recent_queries (phrase, at) VALUES (:phrase, :at);
  DELETE FROM recent_queries WHERE phrase NOT IN (SELECT phrase FROM recent_queries ORDER BY at DESC LIMIT 10);
}

recentQueries:
SELECT phrase FROM recent_queries ORDER BY at DESC;

removeRecentQuery:
DELETE FROM recent_queries WHERE phrase = :phrase;

clearRecentQueries:
DELETE FROM recent_queries;

star:
INSERT OR REPLACE INTO starred (uri, starred_at, name, size, modified_at)
SELECT uri, :at, name, size, modified_at FROM files WHERE uri = :uri;

unstar:
DELETE FROM starred WHERE uri = ?;

-- From the user-state snapshot into a database that has no settings yet.
restoreStar:
INSERT OR IGNORE INTO starred (uri, starred_at, name, size, modified_at) VALUES (?, ?, ?, ?, ?);

allStars:
SELECT uri, starred_at, name, size, modified_at FROM starred;

-- A star whose file is gone moves to an unstarred file with the same name, size and modified_at: the same file under a
-- new uri (a renamed picked folder, a new phone's MediaStore ids). OR IGNORE: two stars never take one file.
relinkStars:
UPDATE OR IGNORE starred SET uri = COALESCE((
  SELECT f.uri FROM files f
  WHERE f.name = starred.name AND f.size = starred.size AND f.modified_at = starred.modified_at
    AND f.uri NOT IN (SELECT uri FROM starred)
  ORDER BY f.id LIMIT 1
), uri)
WHERE uri NOT IN (SELECT uri FROM files);

-- Stars of files that are gone stay, hidden by the JOIN, so a file restored from the trash or a card put back keeps its star.
starredUris:
SELECT s.uri FROM starred s JOIN files f ON f.uri = s.uri;

starredFiles:
SELECT f.* FROM starred s JOIN files f ON f.uri = s.uri ORDER BY s.starred_at DESC LIMIT ? OFFSET ?;

-- Home strip only: OTHER never shows there, and the count agrees with the strip.
starredVisible:
SELECT f.* FROM starred s JOIN files f ON f.uri = s.uri WHERE f.kind != 'OTHER' ORDER BY s.starred_at DESC LIMIT ?;

starredVisibleCount:
SELECT COUNT(*) FROM starred s JOIN files f ON f.uri = s.uri WHERE f.kind != 'OTHER';

starredCount:
SELECT COUNT(*) FROM starred s JOIN files f ON f.uri = s.uri;

contentByIds:
SELECT id, content_text FROM chunks WHERE id IN ?;

renameFile:
UPDATE files SET uri = ?, name = ?, modified_at = ? WHERE id = ?;

renameStar:
UPDATE starred SET uri = ?, name = ?, modified_at = ? WHERE uri = ?;

-- Chunk ids change when content is replaced (and when a chunk gains its vector). Files with content only, and each
-- revision from chunks_by_file alone, so no chunk row is read. Cache term counts, never filenames or embedding metadata.
readContentVersions:
SELECT f.id, (SELECT MAX(c.id) FROM chunks c WHERE c.file_id = f.id) AS revision FROM files f
WHERE f.state = 'INDEXED' AND f.reach & 1;

-- The bits of reach (Store.Reach), each set when some chunk of the file is so. Ordinal 0 is a name vector, metadata
-- text is not extracted content, and labels are content even without a model.
--   1 content: words, labels or a picture's vector;   2 tail text: words waiting for a vector, or a picture with tries left;
--   4 tail queued: 2, with tries left;   8 meaning queued: no vector yet, with tries left;
--   16 meaning reached: a vector, or words whose tries ran out;   32 any vector (ordinal 0 too);   64 any chunk without one.
refreshReach:
UPDATE files SET reach =
  EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.ordinal > 0
    AND (length(trim(c.content_text)) > 0 OR length(trim(c.labels)) > 0 OR (c.vector IS NOT NULL AND c.text IS NULL)))
  + 2 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.ordinal > 0 AND c.vector IS NULL
    AND (length(trim(c.content_text)) > 0 OR (c.visual = 1 AND c.tail_attempts < 3)))
  + 4 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.ordinal > 0 AND c.vector IS NULL AND c.tail_attempts < 3
    AND (length(trim(c.content_text)) > 0 OR c.visual = 1))
  + 8 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.ordinal > 0 AND c.vector IS NULL AND c.tail_attempts < 3)
  + 16 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.ordinal > 0
    AND (c.vector IS NOT NULL OR (c.tail_attempts >= 3 AND length(trim(c.content_text)) > 0)))
  + 32 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.vector IS NOT NULL)
  + 64 * EXISTS (SELECT 1 FROM chunks c WHERE c.file_id = files.id AND c.vector IS NULL)
WHERE id IN ?;

-- What refreshReach covers after a write across the library: files that hold chunks or held them.
reachedFileIds:
SELECT id FROM files WHERE reach != 0 OR id IN (SELECT file_id FROM chunks);

-- Every file, grouped as Store.countsNow reads it: one scan of files_by_reach.
reachCounts:
SELECT kind, state, partial, reach, COUNT(*) AS n FROM files GROUP BY kind, state, partial, reach;

reachCountsIn:
SELECT kind, state, partial, reach, COUNT(*) AS n FROM files WHERE id IN ? GROUP BY kind, state, partial, reach;

filesWithContent:
SELECT * FROM files WHERE id IN :ids AND reach & 1;

failedMeaningFiles:
SELECT DISTINCT file_id FROM chunks WHERE file_id IN ? AND ordinal > 0 AND vector IS NULL AND tail_attempts >= 3 AND length(trim(content_text)) > 0;

lastChunkId:
SELECT COALESCE(MAX(id), 0) FROM chunks;

-- A file's chunks all come from one read, so a file with content and a chunk past :after was read since then.
sessionReadCount:
SELECT COUNT(DISTINCT f.id) FROM chunks c JOIN files f ON f.id = c.file_id
WHERE c.id > :after AND f.kind IN :kinds AND c.ordinal > 0 AND f.reach & 1;

-- The text/label fields are separate so classifier words can never become content snippets.
chunkLabels:
SELECT id, labels FROM chunks WHERE id IN ? AND labels IS NOT NULL;

meaningProgressIn:
SELECT f.id, f.state, COUNT(c.id) AS total, COUNT(c.vector) AS embedded
FROM files f LEFT JOIN chunks c ON c.file_id = f.id WHERE f.id IN ? GROUP BY f.id;
