<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: demo mode and the search eval. Its own task, so it never stacks on the app's. -->
        <activity
            android:name=".DebugActivity"
            android:exported="true"
            android:label="Retriever debug"
            android:taskAffinity="app.retriever.debug">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Debug builds only: every mascot animation, for review. adb shell am start -n app.retriever/.MascotGalleryActivity -->
        <activity
            android:name=".MascotGalleryActivity"
            android:exported="true"
            android:label="Mascot gallery"
            android:taskAffinity="app.retriever.mascot" />
    </application>
</manifest>
