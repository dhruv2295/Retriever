<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Retriever" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The launch window: the icon on its own background, then Theme.Retriever takes over. -->
    <style name="Theme.Retriever.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Retriever</item>
    </style>
</resources>
