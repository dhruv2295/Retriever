<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (API 30). Backups are key-value now (StateBackupAgent); these rules govern restoring a full backup made
     before. The index is rebuilt from the files and the model is downloaded again, so neither comes back; restoring a
     model file without its hash marker would only re-check it. -->
<full-backup-content>
    <exclude domain="database" path="retriever.db" />
    <exclude domain="database" path="retriever.db-wal" />
    <exclude domain="database" path="retriever.db-shm" />
    <exclude domain="database" path="retriever-demo.db" />
    <exclude domain="database" path="retriever-demo.db-wal" />
    <exclude domain="database" path="retriever-demo.db-shm" />
    <exclude domain="external" path="models/" />
</full-backup-content>
