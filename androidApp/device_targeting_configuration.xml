<?xml version="1.0" encoding="utf-8"?>
<!-- Snapdragons with an NPU model build (core ModelBuilds.npu); each group gets its npu/qualcomm_runtime_v* module.
     From google-ai-edge/litert-samples kotlin_npu/android/app/device_targeting_configuration.xml (Apache-2.0). -->
<config:device-targeting-config
    xmlns:config="http://schemas.android.com/apk/config">
    <config:device-group name="Qualcomm_SM8550">
        <config:device-selector><config:system-on-chip manufacturer="Qualcomm" model="SM8550"/></config:device-selector>
        <config:device-selector><config:system-on-chip manufacturer="QTI" model="SM8550"/></config:device-selector>
    </config:device-group>
    <config:device-group name="Qualcomm_SM8650">
        <config:device-selector><config:system-on-chip manufacturer="Qualcomm" model="SM8650"/></config:device-selector>
        <config:device-selector><config:system-on-chip manufacturer="QTI" model="SM8650"/></config:device-selector>
    </config:device-group>
    <config:device-group name="Qualcomm_SM8750">
        <config:device-selector><config:system-on-chip manufacturer="Qualcomm" model="SM8750"/></config:device-selector>
        <config:device-selector><config:system-on-chip manufacturer="QTI" model="SM8750"/></config:device-selector>
    </config:device-group>
    <config:device-group name="Qualcomm_SM8850">
        <config:device-selector><config:system-on-chip manufacturer="Qualcomm" model="SM8850"/></config:device-selector>
        <config:device-selector><config:system-on-chip manufacturer="QTI" model="SM8850"/></config:device-selector>
    </config:device-group>
</config:device-targeting-config>
