    "Search your files and photos by what is inside them.": {
      "comment": "The Shortcuts action's description.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Durchsuche deine Dateien und Fotos nach ihrem Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search your files and photos by what is inside them."
